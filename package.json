{
  "name": "@meteora-ag/dynamic-fee-sharing-sdk",
  "version": "1.1.0",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "source": "src/index.ts",
  "types": "dist/index.d.ts",
  "author": "Dann Wee <dann@raccoons.dev>",
  "keywords": [
    "meteora-ag",
    "dynamic-fee-sharing"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "description": "A Typescript SDK for interacting with the Dynamic Fee Sharing Program on Meteora.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsup src/index.ts --format esm,cjs --dts",
    "clean": "rm -rf node_modules dist",
    "test": "bun test",
    "audit": "bun audit --prod --ignore GHSA-3gc7-fjrx-p6mg --ignore GHSA-528h-pc64-c93x --ignore GHSA-hqr4-qq8f-hg3x --ignore GHSA-mjw6-4jj6-33hc --ignore GHSA-4qx8-w7c3-pj3p --ignore GHSA-82x6-q7mm-w9cf --ignore GHSA-9j65-hcg3-gc64 --ignore GHSA-9qmh-m7c6-f92p --ignore GHSA-v5mp-jgw5-2x6j --ignore GHSA-w5hq-g745-h8pq"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/bun": "latest",
    "@types/chai": "^5.2.2",
    "@types/node": "^26.1.1",
    "chai": "^5.2.0",
    "eslint": "^9.24.0",
    "litesvm": "0.1.0",
    "prettier": "^3.9.6",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@meteora-ag/cp-amm-sdk": "^1.2.0",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.10",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1",
    "decimal.js": "^10.5.0"
  }
